# ============================================================================
#  Customer ClickHouse Credentials — Template
# ============================================================================
#
#  Copy this file to your customer folder as `.env`:
#    cp templates/customer.env.example customers/<customer-name>/.env
#
#  Then fill in the values. This file is gitignored and should NEVER be
#  committed. Claude Code is configured to refuse reading .env files.
#
# ============================================================================

# Required
CH_HOST="your-service.region.provider.clickhouse.cloud"
CH_PASSWORD="your-password-here"

# Optional (defaults shown)
CH_USER="default"
CH_DATABASE=""
CH_SECURE="true"          # Set to "false" for non-TLS connections
